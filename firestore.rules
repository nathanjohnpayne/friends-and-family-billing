rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own top-level document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Year-scoped billing data — owner only, version-checked writes
      // (specs/year-end-review.md § Versioned year-document writes; ADR 0009).
      // Every write carries an integer `rev`: create at rev == 1, update at
      // stored rev + 1. The first versioned write of an unversioned document
      // sets rev == 1 and must keep the stored createdAt (which must exist), so
      // a create-shaped payload cannot overwrite an existing unversioned year.
      // A malformed rev (present, not an integer) on the request or on the
      // stored document matches no branch and is denied. Year documents are
      // never deleted. Admin SDK writers bypass these rules; the source guard
      // in tests/functions.test.js asserts no Cloud Function writes this doc.
      match /billingYears/{yearId} {
        function isOwner() { return request.auth != null && request.auth.uid == userId; }
        function reqRev() { return 'rev' in request.resource.data && request.resource.data.rev is int; }
        function noRev() { return !('rev' in request.resource.data); }        // absent, not merely malformed
        function hasRev() { return 'rev' in resource.data && resource.data.rev is int; }
        function storedNoRev() { return !('rev' in resource.data); }          // the stored field is absent, not merely malformed
        function sameCreatedAt() { return 'createdAt' in resource.data && request.resource.data.createdAt == resource.data.createdAt; }  // present AND unchanged

        allow read: if isOwner();
        allow create: if isOwner() && ((reqRev() && request.resource.data.rev == 1)
                                   );
        allow update: if isOwner() && (
             (reqRev() && hasRev() && request.resource.data.rev == resource.data.rev + 1)     // a versioned write advances by exactly one
          || (reqRev() && storedNoRev() && request.resource.data.rev == 1 && sameCreatedAt()) // the first versioned write of an unversioned document
        );
        allow delete: if false;

        // Disputes — owner only. Share-page member actions (submit a review
        // request, approve/reject a resolution, confirm a refund, fetch evidence)
        // go exclusively through Cloud Functions (Admin SDK), which validate the
        // share token server-side. There is deliberately no unauthenticated
        // client write path here.
        match /disputes/{disputeId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Audit log — owner can read, only server (Admin SDK) can write
      match /auditLog/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Share tokens: owner-scoped.
    // The Cloud Function uses the Admin SDK (bypasses these rules)
    // to resolve tokens on behalf of unauthenticated share-link visitors.
    match /shareTokens/{tokenId} {
      function isTokenOwner() {
        return request.auth != null && resource.data.ownerId == request.auth.uid;
      }

      allow get, list, delete: if isTokenOwner();

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'memberId', 'billingYearId', 'scopes', 'revoked'])
        && request.resource.data.revoked == false;

      // The only client-side mutation of an existing token is revocation:
      // set revoked = true (optionally stamping revokedAt with the server
      // time). Every other field — ownerId, memberId, billingYearId, scopes,
      // expiresAt, … — is immutable after creation.
      allow update: if isTokenOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt'])
        && request.resource.data.revoked == true
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['revokedAt'])
            || request.resource.data.revokedAt == request.time);
    }

    // Public share data — anyone who knows the token hash can fetch that one
    // document (get). Enumerating the collection (list) is owner-scoped, so a
    // query must filter on ownerId == the caller's uid (#424).
    // Only the owner can write (via the main app after generating a share link),
    // and ownerId can never change after creation.
    // Unauthenticated visitors may increment accessCount/lastAccessedAt only.
    match /publicShares/{tokenHash} {
      allow get: if true;

      allow list: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['accessCount', 'lastAccessedAt']);

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Public QR codes — anyone who knows the doc id can fetch it (separated
    // from publicShares to avoid document size limits); listing is
    // owner-scoped (#424). Doc ids are `${ownerId}_${methodId}`, so an owner
    // may only write ids in their own namespace, and ownerId is immutable.
    match /publicQrCodes/{docId} {
      function isOwnQrDocId() {
        return docId.size() > request.auth.uid.size() + 1
          && docId[0:request.auth.uid.size() + 1] == request.auth.uid + '_';
      }

      allow get: if true;

      allow list: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && isOwnQrDocId();

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && isOwnQrDocId();

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Mail queue — authenticated users can create pending emails for their own
    // uid and read their own queue docs. Only the Cloud Function (Admin SDK)
    // can update status. The client may only supply plain fields; the trigger
    // renders HTML server-side from `body`, restricts recipients to the
    // sender's own address or their household members' addresses, requires a
    // verified sender email, and rate-limits per uid. Server-enqueued mail
    // (share-page notifications) is written via the Admin SDK and carries
    // fields a client can never set here.
    match /mailQueue/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['to', 'subject', 'body', 'uid', 'status'])
        && request.resource.data.keys().hasOnly(['to', 'subject', 'body', 'uid', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.to is string
        && request.resource.data.to.size() <= 320
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 500
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 100000
        && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt == request.time);

      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Deny everything else by default (implicit, but explicit for clarity)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
