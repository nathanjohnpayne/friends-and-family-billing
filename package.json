{
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:react && npm run build:assemble",
    "build:react": "vite build",
    "build:assemble": "node scripts/assemble-deploy.js",
    "postinstall": "cd functions && npm install",
    "dev": "vite --open",
    "pr:auto": "node scripts/pr-auto.mjs",
    "preview": "vite preview",
    "test": "npm run test:react && npm run test:functions && npm run test:secrets",
    "test:functions": "node --test 'tests/functions.test.js'",
    "test:react": "vitest run",
    "test:rules": "scripts/test-rules.sh",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "export VITE_E2E_MODE=true && npm run build:react && npm run build:assemble && npx playwright test",
    "test:secrets": "node scripts/check-no-public-secrets.mjs",
    "lint": "eslint .",
    "deploy": "op-firebase-deploy --only hosting,firestore:rules,storage",
    "deploy:functions": "op-firebase-deploy --only functions",
    "deploy:all": "op-firebase-deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "overrides": {
    "brace-expansion": "^1.1.16",
    "protobufjs": "^7.6.5",
    "@grpc/grpc-js": "1.14.5"
  }
}
